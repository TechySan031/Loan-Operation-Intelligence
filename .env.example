# ============================================================
# Loan Operation Intelligence — Environment Variables Template
# Copy this file to .env:  cp .env.example .env
# ============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=loi_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=loan_operation_intelligence
DATABASE_URL=postgresql+asyncpg://loi_user:changeme@localhost:5432/loan_operation_intelligence

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o
OPENAI_LLM_MODEL_MINI=gpt-4o-mini

# --- Pinecone ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=loan-kb
PINECONE_ENVIRONMENT=us-east-1

# --- Vapi.ai (Voice Platform) ---
VAPI_API_KEY=your_vapi_private_key_here
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here
NEXT_PUBLIC_VAPI_INDIA_ASSISTANT=f841c4aa-d335-46fa-871d-f0c15cd3e531
NEXT_PUBLIC_VAPI_PH_ASSISTANT=cbe68c54-2f0b-4dd7-9dbf-6034ffb4d745
NEXT_PUBLIC_VAPI_ID_ASSISTANT=aaa74544-289d-4a0e-95d3-99df028aa232
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
VAPI_SERVER_URL=https://your-domain.com/api/voice/webhook

# --- Deepgram (Streaming ASR) ---
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# --- Langfuse (Observability - Optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- PII Detection ---
PII_DETECTION_ENABLED=true
PII_DETECTION_THRESHOLD=0.7
